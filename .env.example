# Runtime environment: "development" or "production".
# In production the API refuses to start without JWT_SECRET.
APP_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/plagiarism_engine_db

# Storage backend: "local" or "supabase"
STORAGE_BACKEND=local

# Supabase config (only needed if STORAGE_BACKEND=supabase)
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_KEY=eyJhbG...
SUPABASE_STORAGE_BUCKET=project-files

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Absolute path to the shared models directory, e.g.
# MODELS_DIR=D:\AI engine\models
# Required sub-folders: unixcoder-base (code), bge-m3 (text), all-MiniLM-L6-v2 (fallback)
MODELS_DIR=./models
