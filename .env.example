# Point this to the shared models directory (no need to duplicate large ML models)
MODELS_DIR=D:\AI engine\models

# PostgreSQL connection (optional — falls back to SQLite automatically)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/plagiarism_engine_db

# Data directory for SQLite DB, ChromaDB, and scan history
# PLAGIARISM_DATA_DIR=./data

# Frontend API URL (only needed if frontend is on a different host)
# VITE_API_URL=http://127.0.0.1:8000
